{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:display_context",
  "cases": [
   {
    "when": [
     "firstperson_righthand",
     "firstperson_lefthand"
    ],
    "model": {
     "type": "minecraft:model",
     "model": "tresmodos:item/mina_fp"
    }
   },
   {
    "when": [
     "thirdperson_righthand",
     "thirdperson_lefthand"
    ],
    "model": {
     "type": "minecraft:model",
     "model": "tresmodos:item/mina_tp"
    }
   },
   {
    "when": "none",
    "model": {
     "type": "minecraft:model",
     "model": "tresmodos:item/mina_mundo"
    }
   }
  ],
  "fallback": {
   "type": "minecraft:model",
   "model": "tresmodos:item/mina_gui"
  }
 }
}
